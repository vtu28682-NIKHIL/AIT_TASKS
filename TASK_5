import numpy as np
from numpy import inf

# Given values for the problem
d = np.array([
    [0, 10, 12, 11, 14],
    [10, 0, 13, 15, 8],
    [12, 13, 0, 9, 14],
    [11, 15, 9, 0, 16],
    [14, 8, 14, 16, 0]
])

iteration = 100
n_ants = 5
n_citys = 5

# Initialization
m = n_ants
n = n_citys

e = 0.5       # evaporation rate
alpha = 1     # pheromone factor
beta = 2      # visibility factor

# Calculating visibility of the next city
# visibility(i,j) = 1 / d(i,j)

visibility = np.zeros_like(d, dtype=float)

# Avoid division by zero on diagonal
visibility[d != 0] = 1 / d[d != 0]

# Initializing pheromone on paths
pheromne = 0.1 * np.ones((n, n))

# Initializing route of ants
# Size = (n_ants, n_citys + 1)
# +1 because the ant returns to the starting city
rute = np.ones((m, n + 1), dtype=int)

for ite in range(iteration):

    # Every ant starts from city 1
    rute[:, 0] = 1

    for i in range(m):

        temp_visibility = np.array(visibility)

        for j in range(n - 1):

            # Current city
            cur_loc = int(rute[i, j] - 1)

            # Current city cannot be selected again
            temp_visibility[:, cur_loc] = 0

            # Pheromone feature
            p_feature = np.power(pheromne[cur_loc, :], alpha)

            # Visibility feature
            v_feature = np.power(temp_visibility[cur_loc, :], beta)

            # Combined feature
            combine_feature = p_feature * v_feature

            # Total probability value
            total = np.sum(combine_feature)

            # Calculate probabilities
            probs = combine_feature / total

            # Cumulative probability
            cum_prob = np.cumsum(probs)

            # Random number
            r = np.random.random_sample()

            # Find next city
            city = np.nonzero(cum_prob > r)[0][0] + 1

            # Add city to route
            rute[i, j + 1] = city

        # Find the last unvisited city
        visited = set(rute[i, :n - 1])
        all_cities = set(range(1, n + 1))
        left = list(all_cities - visited)[0]

        # Add last city
        rute[i, n - 1] = left

        # Return to starting city
        rute[i, n] = 1

    # Copy routes
    rute_opt = np.array(rute)

    # Total distance of each ant
    dist_cost = np.zeros(m)

    for i in range(m):

        s = 0

        for j in range(n):

            s += d[
                int(rute_opt[i, j]) - 1,
                int(rute_opt[i, j + 1]) - 1
            ]

        dist_cost[i] = s

    # Find minimum distance
    dist_min_loc = np.argmin(dist_cost)

    # Minimum distance
    dist_min_cost = dist_cost[dist_min_loc]

    # Best route
    best_route = rute[dist_min_loc, :]

    # Pheromone evaporation
    pheromne = (1 - e) * pheromne

    # Update pheromone
    for i in range(m):

        for j in range(n):

            dt = 1 / dist_cost[i]

            from_city = int(rute_opt[i, j]) - 1
            to_city = int(rute_opt[i, j + 1]) - 1

            pheromne[from_city, to_city] += dt


# Display results
print("Route of all the ants at the end:")
print(rute_opt)

print()

print("Best path:")
print(best_route)

print()

print("Cost of the best path:")
print(int(dist_min_cost))